{
  "expo": {
    "name": "Pulido Wear Log",
    "slug": "pulido-wear-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulido-wear-log",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#343D30"
    },
    "ios": {
      "bundleIdentifier": "com.houseofpulido.wearlog",
      "supportsTablet": true
    },
    "android": {
      "package": "com.houseofpulido.wearlog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#343D30"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
